---
// src/components/Masthead.astro
interface Props {
  backTo?: { href: string; label: string };
}

const { backTo } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class="masthead">
  {backTo && (
    <a href={backTo.href} class="masthead-back">← {backTo.label}</a>
  )}
  <img src="/photo.jpg" alt="Daniel Choi" class="masthead-photo" />
  <div class="masthead-name">Daniel Choi</div>
  <div class="masthead-role">Software Engineer &nbsp;·&nbsp; Los Angeles</div>
  <nav class="masthead-nav">
    <a href="/work" class={currentPath.startsWith('/work') ? 'active' : ''}>Work</a>
    <a href="/writing" class={currentPath.startsWith('/writing') ? 'active' : ''}>Writing</a>
    <a href="/about" class={currentPath === '/about' ? 'active' : ''}>About</a>
  </nav>
</header>

<style>
  .masthead {
    text-align: center;
    padding: 56px 0 44px;
    border-bottom: 4px double var(--rule);
    margin-bottom: 64px;
  }
  .masthead-back {
    display: inline-block;
    margin-bottom: 28px;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
  }
  .masthead-back:hover { color: var(--accent); }
  .masthead-photo {
    width: 110px;
    height: 110px;
    margin: 0 auto 20px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--rule);
    background: #e4d8bc;
    display: block;
  }
  .masthead-name {
    font-family: var(--serif);
    font-size: 44px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.1;
    color: var(--ink);
  }
  .masthead-role {
    margin-top: 10px;
    font-size: 13px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
  }
  .masthead-nav { margin-top: 22px; font-size: 15px; }
  .masthead-nav a {
    color: var(--ink);
    text-decoration: none;
    margin: 0 14px;
    border-bottom: 1px solid transparent;
  }
  .masthead-nav a:hover { color: var(--accent); border-bottom-color: var(--accent); }
  .masthead-nav a.active { color: var(--accent); }

  @media (max-width: 480px) {
    .masthead { padding: 40px 0 32px; margin-bottom: 48px; }
    .masthead-photo { width: 88px; height: 88px; }
    .masthead-name { font-size: 34px; }
    .masthead-role { font-size: 11px; letter-spacing: 0.22em; }
  }
</style>

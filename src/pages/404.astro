---
// src/pages/404.astro
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <main class="reading-col">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Daniel Choi</a></nav>
    <h1 class="page-title">Page not found</h1>
    <p class="message">There's nothing at this address. Try the <a href="/">home page</a> or the <a href="/projects">list of projects</a>.</p>
    <p class="site-foot">Daniel Choi, 2026</p>
  </main>
</Base>

<style>
  main { padding-bottom: 80px; }
  .message { font-family: var(--text); max-width: 60ch; }
</style>

---
// src/pages/about.astro
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
---

<Base title="About">
  <div class="col">
    <Masthead />

    <div class="about-head">
      <div class="photo-frame">
        <img src="/photo.jpg" alt="Daniel Choi" class="about-photo" />
      </div>
      <div>
        <h1>About</h1>
      </div>
    </div>

    <div class="prose about-body">
      <p>
        I'm a full-stack engineer at CatalogIt, which makes collection management software
        for museums, galleries, and collectors. I build AI features, like the LLM pipeline
        behind our CSV importer, and the billing and checkout code that has to be right every time.
      </p>
      <p>
        I care most about the parts of a product that don't fit in a demo: error handling,
        fallbacks, and making sure the numbers match. Outside of work, I read more than I write
        (working on it).
      </p>
    </div>

    <div class="strips">
      <div class="strip">
        <p class="strip-label">Elsewhere</p>
        <div class="strip-links">
          <a href="https://github.com/dchoiboi00">GitHub</a><span class="dot">·</span><a href="https://linkedin.com/in/danielyoochoi">LinkedIn</a><span class="dot">·</span><a href="mailto:dchoiboi00@gmail.com">Email</a>
        </div>
      </div>

    </div>
  </div>
</Base>

<style>
  .about-head {
    display: flex;
    gap: 28px;
    align-items: flex-start;
    margin-bottom: 44px;
  }
  .photo-frame {
    width: 120px;
    flex-shrink: 0;
    border: 1px solid var(--rule);
    padding: 6px;
    background: #fffdf6;
  }
  .about-photo {
    width: 100%;
    aspect-ratio: 3 / 3.6;
    object-fit: cover;
    display: block;
    background: #e4d8bc;
  }
  .about-head h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(36px, 5.4vw, 50px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin-bottom: 10px;
    color: var(--ink);
  }
  .about-body { margin-bottom: 56px; }
  .about-body p { margin-bottom: 1.4em; max-width: 66ch; }
  .strips { border-top: 4px double var(--rule); margin-bottom: 16px; }
  .strip { padding: 22px 0; border-bottom: 1px solid var(--rule); }
  .strip-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 10px;
  }
  .strip-links { font-size: 16px; }
  .strip-links a {
    color: var(--ink);
    border-bottom: 1px solid var(--rule);
  }
  .strip-links a:hover { color: var(--accent); border-bottom-color: var(--accent); }
  .strip-links .dot { color: var(--faint); margin: 0 10px; }

  @media (max-width: 480px) {
    .about-head { flex-direction: column; }
  }
</style>

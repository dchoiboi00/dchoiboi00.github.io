---
// src/pages/index.astro
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<Base>
  <div class="col">
    <Masthead />

    <section class="hero">
      <h1>Engineer turning AI<br /><em>into shipped products.</em></h1>
    </section>

    <p class="intro">
      I'm a full-stack engineer at CatalogIt, which makes collection management
      software for museums and collectors. I build AI features, like an LLM pipeline
      that maps a customer's spreadsheet for them, and the billing and checkout code
      that has to be right every time.
    </p>

    {posts.length > 0 && (
      <section>
        <div class="kicker">Recent Writing</div>
        <div class="writing-list">
          {posts.map((post) => (
            <a href={`/writing/${post.id}`} class="writing-row">
              <span class="writing-title">{post.data.title}</span>
              <span class="writing-year">{formatDate(post.data.date)}</span>
            </a>
          ))}
        </div>
        <a href="/writing" class="more">All writing →</a>
      </section>
    )}
  </div>
</Base>

<style>
  .hero { margin-bottom: 30px; }
  .hero h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(40px, 6.4vw, 62px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    text-wrap: balance;
    color: var(--ink);
  }
  .hero h1 em { font-style: italic; font-weight: 400; color: var(--accent); }
  .intro {
    font-family: var(--serif-dek);
    font-size: clamp(19px, 2.4vw, 23px);
    line-height: 1.55;
    color: #4a4033;
    max-width: 60ch;
    margin-bottom: 72px;
  }
  .kicker {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 8px;
  }
  .kicker::before,
  .kicker::after { content: ""; height: 1px; background: var(--rule); flex: 1; }
  .writing-list { border-top: 1px solid var(--rule); margin-bottom: 16px; }
  .writing-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    padding: 18px 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
  }
  .writing-title {
    font-family: var(--serif);
    font-size: 21px;
    font-weight: 500;
    line-height: 1.35;
  }
  .writing-row:hover .writing-title { color: var(--accent); }
  .writing-year {
    font-size: 13px;
    letter-spacing: 0.18em;
    color: var(--faint);
    flex-shrink: 0;
  }
  .more {
    display: inline-block;
    margin-top: 6px;
    font-size: 14px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
  }
  .more:hover { text-decoration: underline; text-underline-offset: 4px; }
</style>

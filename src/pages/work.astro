---
// src/pages/work.astro
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import { keepHyphenatedWords } from '../lib/keep-hyphenated-words.mjs';

const projects = [
  {
    name: 'CSV auto-mapper',
    description: "LLM pipeline that maps the columns of a customer's spreadsheet to the right fields in CatalogIt, so museums can import decades of records without a setup call. It maps a full CSV in 15–30 seconds.",
    period: 'Oct 2025 – Feb 2026',
    tags: 'TYPESCRIPT · LLMS · EMBEDDINGS · REDIS',
    links: [{ label: 'Case study', href: '/writing/csv-schema-mapper-at-catalogit' }],
    image: '/work/csv-mapper-diagram.svg',
  },
  {
    name: 'Plan limit enforcement',
    description: 'Daily job that finds accounts over their plan limits and moves them through a 15-day countdown: in-app notices, an email drip, then a read-only freeze that lifts the moment they pay. Turned 600 unenforced accounts into 15% MRR growth in the first month.',
    period: 'Sep 2026',
    tags: 'TYPESCRIPT · SCHEDULED JOBS',
    links: [{ label: 'Case study', href: '/writing/account-capacity-enforcement-at-catalogit' }],
    image: '/work/capacity-enforcement-diagram.svg',
  },
  {
    name: 'Billing migration',
    description: 'Moved 3,000 paying accounts ($800K ARR) from per-user to per-account Stripe billing with zero downtime, using phased webhook versioning, a dry-run-first backfill checked by a verifier, and a staged rollout with instant rollback.',
    period: 'Apr – Jun 2026',
    tags: 'TYPESCRIPT · STRIPE',
    links: [{ label: 'Case study', href: '/writing/zero-downtime-billing-migration-at-catalogit' }],
    image: '/work/billing-migration-diagram.svg',
  },
  {
    name: 'Adjust Plan wizard',
    description: 'Rebuilt the plan-change checkout as an XState state machine with four steps and three async services, replacing a pile of booleans with an explicit, testable statechart.',
    period: 'Jun – Jul 2026',
    tags: 'TYPESCRIPT · REACT · XSTATE · STRIPE',
    links: [{ label: 'Case study', href: '/writing/adjust-plan-wizard-xstate-at-catalogit' }],
    image: '/work/xstate-wizard-diagram.svg',
  },
] as const;
---

<Base title="Work">
  <div class="col">
    <Masthead />

    <h1 class="page-title">Work</h1>
    <p class="page-dek" set:html={keepHyphenatedWords('Selected projects from my work at CatalogIt. The code is closed source, so each one links to a write-up.')} />

    <div class="project-list">
      {projects.map((p) => (
        <div class="project-row">
          {p.image && <img src={p.image} alt={p.name} class="project-image" />}
          <div class="project-body">
            <div class="project-main">
              <span class="project-name" set:html={keepHyphenatedWords(p.name)} />
              <div class="project-links">
                {p.links.map((l) => (
                  <a href={l.href} class="project-link">{l.label}</a>
                ))}
              </div>
            </div>
            <p class="project-description" set:html={keepHyphenatedWords(p.description)} />
            <p class="meta project-tags">{p.period} · {p.tags}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</Base>

<style>
  .page-title {
    font-family: var(--serif);
    font-size: 28px;
    font-weight: 400;
    color: var(--text-primary);
    margin-bottom: 6px;
  }
  .page-dek {
    font-family: var(--serif);
    font-size: 15px;
    font-style: italic;
    color: var(--text-muted);
    margin-bottom: 32px;
  }
  .project-list { border-top: 1px solid var(--rule); }
  .project-row {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 20px;
    padding: 18px 0;
    border-bottom: 1px solid var(--rule);
  }
  .project-image {
    width: 160px;
    height: 110px;
    object-fit: cover;
    background: #e8e1d0;
    border: 1px solid var(--rule);
  }
  .project-body { min-width: 0; }
  @media (max-width: 480px) {
    .project-row { grid-template-columns: 1fr; }
    .project-image { width: 100%; height: 160px; }
  }
  .project-main {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 6px;
  }
  .project-name {
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
  }
  .project-links { display: flex; gap: 12px; }
  .project-link {
    font-family: var(--sans);
    font-size: 11px;
    color: var(--accent);
  }
  .project-link:hover { text-decoration: underline; }
  .project-description {
    font-family: var(--sans);
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.55;
    margin-bottom: 6px;
  }
  .project-tags { font-size: 9px; letter-spacing: 0.5px; }
</style>

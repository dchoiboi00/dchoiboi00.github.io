---
// src/pages/writing/index.astro
import Base from '../../layouts/Base.astro';
import Masthead from '../../components/Masthead.astro';
import { getCollection } from 'astro:content';
import { keepHyphenatedWords } from '../../lib/keep-hyphenated-words.mjs';

const posts = (await getCollection('writing'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const titleCase = (s: string) => s.toLowerCase().replace(/\b\w/g, (c) => c.toUpperCase());
const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<Base title="Writing">
  <div class="col">
    <Masthead />

    <div class="page-head">
      <h1>Writing</h1>
      <p class="dek">Case studies from my work at CatalogIt.</p>
    </div>

    <div>
      {posts.map((post) => (
        <div class="post">
          <p class="meta">
            {titleCase(post.data.type)} &nbsp;·&nbsp; {formatDate(post.data.date)}
            {post.data.readTime && <>&nbsp;·&nbsp; {post.data.readTime}</>}
          </p>
          <h2 class="title"><a href={`/writing/${post.id}`} set:html={keepHyphenatedWords(post.data.title)} /></h2>
          {post.data.dek && <p class="dek" set:html={keepHyphenatedWords(post.data.dek)} />}
        </div>
      ))}
    </div>
  </div>
</Base>

<style>
  .page-head { margin-bottom: 56px; }
  .page-head h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(38px, 6vw, 54px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin-bottom: 14px;
    color: var(--ink);
  }
  .page-head .dek {
    font-family: var(--serif-dek);
    font-style: italic;
    font-size: clamp(19px, 2.4vw, 23px);
    line-height: 1.5;
    color: #4a4033;
  }
  .post { padding: 34px 0; border-top: 1px solid var(--rule); }
  .post:last-of-type { border-bottom: 1px solid var(--rule); }
  .post .meta { margin-bottom: 12px; }
  .post .title {
    font-family: var(--serif);
    font-size: 27px;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-bottom: 10px;
  }
  .post .title a { color: var(--ink); }
  .post .title a:hover { color: var(--accent); }
  .post .dek {
    font-family: var(--serif-dek);
    font-style: italic;
    font-size: 18px;
    line-height: 1.5;
    color: #4a4033;
  }
</style>
